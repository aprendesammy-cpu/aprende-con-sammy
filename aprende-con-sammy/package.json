{
  "name": "aprende-con-sammy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:auth && npm run test:ui",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:auth": "node --import tsx tests/run-auth-smoke.mts",
    "test:ui": "vitest run --config vitest.config.ts",
    "verify:styles": "python3 scripts/check-tailwind-tokens.py",
    "check:schema": "python3 scripts/check-schema.py",
    "check:styles": "python3 scripts/check-tailwind-tokens.py",
    "verify": "npm run test && npm run lint && npm run build && npm run check:schema && npm run check:styles"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
